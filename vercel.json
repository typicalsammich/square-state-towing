{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/about-us", "destination": "/about/", "permanent": true },
    { "source": "/testimonials", "destination": "/reviews/", "permanent": true }
  ]
}
